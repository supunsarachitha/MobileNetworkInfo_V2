<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand -->
    <Color x:Key="PrimaryLight">#0A8F63</Color>
    <Color x:Key="PrimaryDark">#4FD6A1</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#00391F</Color>
    <Color x:Key="PrimaryContainerLight">#D3F5E6</Color>
    <Color x:Key="PrimaryContainerDark">#0F3B2C</Color>
    <Color x:Key="OnPrimaryContainerLight">#04563A</Color>
    <Color x:Key="OnPrimaryContainerDark">#B5F2D7</Color>

    <!-- Hero gradient -->
    <Color x:Key="HeroStartLight">#0A8F63</Color>
    <Color x:Key="HeroEndLight">#05603F</Color>
    <Color x:Key="HeroStartDark">#136B4D</Color>
    <Color x:Key="HeroEndDark">#0A3F2D</Color>

    <!-- Surfaces -->
    <Color x:Key="BackgroundLight">#F3F6F4</Color>
    <Color x:Key="BackgroundDark">#0D1210</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#161D1A</Color>
    <Color x:Key="SurfaceVariantLight">#EAF0ED</Color>
    <Color x:Key="SurfaceVariantDark">#1F2824</Color>
    <Color x:Key="OutlineLight">#E0E7E3</Color>
    <Color x:Key="OutlineDark">#26302B</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryLight">#17201C</Color>
    <Color x:Key="TextPrimaryDark">#E4EBE7</Color>
    <Color x:Key="TextSecondaryLight">#5C6A64</Color>
    <Color x:Key="TextSecondaryDark">#96A6A0</Color>

    <!-- Status -->
    <Color x:Key="GoodColor">#1E9E5A</Color>
    <Color x:Key="FairColor">#E3A008</Color>
    <Color x:Key="PoorColor">#D64545</Color>
    <Color x:Key="InfoColor">#2F7DE1</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Transparent">#00000000</Color>

</ResourceDictionary>
