<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>MobileNetworkInfo</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>Mobile Network Info</ApplicationTitle>

		<!-- App identifier: must match the Google Play listing -->
		<ApplicationId>lk.stechbuzz.networktoggler</ApplicationId>

		<!-- Versions: ApplicationVersion is the Play Store versionCode and must increase with every upload -->
		<ApplicationDisplayVersion>5.0</ApplicationDisplayVersion>
		<ApplicationVersion>32</ApplicationVersion>

		<!-- Android 6.0+. targetSdkVersion follows the TFM (API 36 / Android 16) -->
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>

		<!-- .NET 10 builds 64-bit only by default; keep 32-bit ARM for older and Android Go phones -->
		<RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>

		<!-- Compile bindings that use Source={RelativeSource ...} too (faster, trim-safe) -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- .aab is uploaded to Google Play, .apk is for direct installs / testing -->
		<AndroidPackageFormats>aab;apk</AndroidPackageFormats>
	</PropertyGroup>

	<!--
		Release signing. Keystore details are kept out of source control: put them in
		signing.local.props (git-ignored, see signing.local.props.example) or pass them
		on the command line, e.g. -p:AndroidSigningStorePass=env:KEYSTORE_PASS
	-->
	<Import Project="signing.local.props" Condition="Exists('signing.local.props')" />
	<PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(AndroidSigningKeyStore)' != ''">
		<AndroidKeyStore>true</AndroidKeyStore>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0A8F63" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0A8F63" BaseSize="192,192" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- The repository changelog is shown in the app's "What's new" page -->
		<MauiAsset Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
	</ItemGroup>

</Project>
